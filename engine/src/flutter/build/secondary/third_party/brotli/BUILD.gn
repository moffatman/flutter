source_root = "//flutter/third_party/brotli"

config("brotli_public") {
  include_dirs = [
    "$source_root/c/include",
    "$source_root/c/common/dictionary.h",
  ]

  cflags = []
  foreach(dir, include_dirs) {
    cflags += [
      "-isystem",
      rebase_path(dir),
    ]
  }
}

static_library("brotli") {
  # Brotli is used by freetype; it only needs the brotli decoder.
  sources = [
    "$source_root/c/common/constants.c",
    "$source_root/c/common/context.c",
    "$source_root/c/common/dictionary.c",
    "$source_root/c/common/platform.c",
    "$source_root/c/common/shared_dictionary.c",
    "$source_root/c/common/transform.c",
    "$source_root/c/dec/bit_reader.c",
    "$source_root/c/dec/decode.c",
    "$source_root/c/dec/huffman.c",
    "$source_root/c/dec/state.c",
  ]

  public_configs = [ ":brotli_public" ]
  cflags = [ "-w" ]
}

static_library("brotli_encoder") {
  sources = [
    "$source_root/c/enc/backward_references.c",
    "$source_root/c/enc/backward_references_hq.c",
    "$source_root/c/enc/bit_cost.c",
    "$source_root/c/enc/block_splitter.c",
    "$source_root/c/enc/brotli_bit_stream.c",
    "$source_root/c/enc/cluster.c",
    "$source_root/c/enc/command.c",
    "$source_root/c/enc/compound_dictionary.c",
    "$source_root/c/enc/compress_fragment.c",
    "$source_root/c/enc/compress_fragment_two_pass.c",
    "$source_root/c/enc/dictionary_hash.c",
    "$source_root/c/enc/encode.c",
    "$source_root/c/enc/encoder_dict.c",
    "$source_root/c/enc/entropy_encode.c",
    "$source_root/c/enc/fast_log.c",
    "$source_root/c/enc/histogram.c",
    "$source_root/c/enc/literal_cost.c",
    "$source_root/c/enc/memory.c",
    "$source_root/c/enc/metablock.c",
    "$source_root/c/enc/static_dict.c",
    "$source_root/c/enc/utf8_util.c",
  ]

  deps = [ ":brotli" ]
  public_configs = [ ":brotli_public" ]
  cflags = [ "-w" ]
}

group("brotli_full") {
  public_deps = [
    ":brotli",
    ":brotli_encoder",
  ]
}
